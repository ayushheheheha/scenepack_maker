{
  "name": "scenepack-maker",
  "version": "0.2.0",
  "description": "ScenePack Maker — desktop tool for clipping and organizing drama scene packs",
  "private": true,
  "main": "electron/main.js",
  "author": "Ayush",
  "license": "MIT",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && node scripts/dev-electron.js",
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder --config electron-builder.config.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  }
}
